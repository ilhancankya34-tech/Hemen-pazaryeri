
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>HEMEN - Alışveriş</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial;background:#f5f5f5;color:#222}
header{background:#ff7200;color:white;padding:20px}
.logo{font-size:34px;font-weight:bold}
input{width:100%;padding:13px;margin:8px 0;border:1px solid #ddd;border-radius:8px}
button{background:#ff7200;color:white;border:0;padding:13px;border-radius:8px;font-weight:bold}
nav{background:white;padding:15px;display:flex;justify-content:space-around}
nav a{color:#ff7200;text-decoration:none;font-weight:bold}
.hero{background:#ff7200;color:white;text-align:center;padding:35px 15px}
.panel{background:white;margin:15px;padding:20px;border-radius:12px}
.panel h2{color:#ff7200}
.products{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;padding:15px}
.product{background:white;padding:12px;border-radius:10px}
.product img{width:100%;height:110px;object-fit:contain}
.price{color:#ff7200;font-weight:bold}
footer{background:#222;color:white;text-align:center;padding:20px}
</style>
</head>
<body>

<header>
<div class="logo">🛒 HEMEN</div>
<p>Aradığın her şey HEMEN yanında!</p>
<input id="search" placeholder="Ürün ara..." oninput="ara()">
</header>

<nav>
<a href="#anasayfa">Ana Sayfa</a>
<a href="#urunler">Ürünler</a>
<a href="#satici">Satıcı Ol</a>
</nav>

<section class="hero" id="anasayfa">
<h1>HEMEN Alışverişe Başla!</h1>
<p>Türkiye'nin yeni alışveriş platformu</p>
</section>

<h2 style="padding:15px">Ürünler</h2>
<div class="products" id="urunler"></div>

<section class="panel" id="satici">
<h2>🏪 SATICI PANELİ</h2>
<p><b>Mağaza:</b> Bilişim Teknoloji</p>
<p><b>Mağaza sahibi:</b> İlhan Kaya</p>
<p><b>Şehir:</b> Malatya</p>
<hr>

<h3>Yeni Ürün Ekle</h3>
<input id="ad" placeholder="Ürün adı">
<input id="fiyat" type="number" placeholder="Fiyat (TL)">
<input id="stok" type="number" placeholder="Stok miktarı">
<input id="foto" type="url" placeholder="Fotoğraf bağlantısı (isteğe bağlı)">
<button style="width:100%" onclick="ekle()">ÜRÜNÜ EKLE</button>

<hr>
<h3>Mağaza Ürünlerim</h3>
<div id="liste"></div>
<p>Toplam ürün: <b id="adet">0</b></p>
</section>

<footer>
<h2>HEMEN 🧡</h2>
<p>Alışverişin yeni adresi</p>
</footer>

<script>
let urunler=JSON.parse(localStorage.getItem("hemenUrunler")||"[]");

function kaydet(){
localStorage.setItem("hemenUrunler",JSON.stringify(urunler));
}

function guvenli(yazi){
let d=document.createElement("div");
d.textContent=yazi;
return d.innerHTML;
}

function ekle(){
let ad=document.getElementById("ad").value.trim();
let fiyat=Number(document.getElementById("fiyat").value);
let stok=Number(document.getElementById("stok").value);
let foto=document.getElementById("foto").value.trim();

if(!ad||fiyat<=0||stok<0||
document.getElementById("fiyat").value===""||
document.getElementById("stok").value===""){
alert("Ürün bilgilerini eksiksiz girin.");
return;
}

urunler.push({ad,fiyat,stok,foto});
kaydet();
goster();

document.getElementById("ad").value="";
document.getElementById("fiyat").value="";
document.getElementById("stok").value="";
document.getElementById("foto").value="";
alert("Ürün eklendi!");
}

function sil(i){
urunler.splice(i,1);
kaydet();
goster();
}

function goster(){
document.getElementById("adet").innerText=urunler.length;

document.getElementById("urunler").innerHTML=
urunler.map(u=>`
<div class="product">
${u.foto?`<img src="${guvenli(u.foto)}">`:"📦"}
<h3>${guvenli(u.ad)}</h3>
<p class="price">${u.fiyat} TL</p>
<p>Stok: ${u.stok}</p>
</div>`).join("");

document.getElementById("liste").innerHTML=
urunler.map((u,i)=>`
<div style="background:#f5f5f5;padding:12px;margin:8px 0;border-radius:8px">
<b>${guvenli(u.ad)}</b>
<p>${u.fiyat} TL | Stok: ${u.stok}</p>
<button onclick="sil(${i})">Sil</button>
</div>`).join("")||"Henüz ürün eklenmedi.";
}

function ara(){
let q=document.getElementById("search").value.toLocaleLowerCase("tr");
document.querySelectorAll("#urunler .product").forEach(p=>{
p.style.display=p.innerText.toLocaleLowerCase("tr").includes(q)?"block":"none";
});
}
goster();
</script>
</body>
</html>
